{
  "name": "byb-shop-backend",
  "version": "0.1.0",
  "description": "Backyardboys Medusajs Backend",
  "author": "Matthias Streicher (Backyardboys)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "migrate": "medusa db:migrate",
    "user": "medusa user -e test@backyardboys.at -p STRGnPdk9mnnENyibq5Y",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/loyalty-plugin": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "pdfmake": "0.2.20"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.14.2",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@types/pdfmake": "0.2.11",
    "babel": "^6.23.0",
    "jest": "30.3.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1"
}
